module Prelude is

# ============================================================

# Primitive Types

# ============================================================

# Unit

# Int

# Float

# Char

# IO a  (a lazy action value: building one has no effect; only the program entry point runs it)

# are assumed to exist.

# ============================================================

# Algebraic Types

# ============================================================

type List a = Nil + Cons (a * List a)
end

type String = List Char
end

type Maybe a = Val a + Nil
end

type Either a b = Left a + Right b
end

type Bool = False + True
end

# TODO actually do something with this
type Nat = Zero + Succ Nat
end

# ============================================================

# Type-specific compiler inserted functions

# ============================================================

let mod
    : Int -> Int -> Int
    = undefined
end

# ============================================================

# Combinators

# ============================================================

let I a
    : a -> a
    = fn x -> x end
end

let id a
    : a -> a
    = I
end

let K a b
    : a -> b -> a
    = fn x ->
        fn y -> x end
    end
end

let const a b
    : a -> b -> a
    = K
end

let S a b c
    : (a -> b -> c) -> (a -> b) -> a -> c
    = fn f ->
        fn g ->
            fn x ->
                f x (g x)
            end
        end
    end
end

let ap a b c
    : (a -> b -> c) -> (a -> b) -> a -> c
    = S
end

let C a b c
    : (a -> b -> c) -> b -> a -> c
    = fn f ->
        fn y ->
            fn x ->
                f x y
            end
        end
    end
end

let flip a b c
    : (a -> b -> c) -> b -> a -> c
    = C
end

let Phi a b c d
    : (b -> c -> d) -> (a -> b) -> (a -> c) -> a -> d
    = fn f ->
        fn g ->
            fn h ->
                fn x ->
                    f (g x) (h x)
                end
            end
        end
    end
end

let fork a b c d
    : (b -> c -> d) -> (a -> b) -> (a -> c) -> a -> d
    = Phi
end

let D2 a b c d e
    : (b -> c -> d) -> (a -> b) -> (e -> c) -> a -> e -> d
    = fn f ->
        fn g ->
            fn h ->
                fn x ->
                    fn y ->
                        f (g x) (h y)
                    end
                end
            end
        end
    end
end

let fork2 a b c d e
    : (b -> c -> d) -> (a -> b) -> (e -> c) -> a -> e -> d
    = D2
end

let Psi a b c
    : (b -> b -> c) -> (a -> b) -> a -> a -> c
    = fn f ->
        fn g ->
            fn x ->
                fn y ->
                    f (g x) (g y)
                end
            end
        end
    end
end

let over a b c
    : (b -> b -> c) -> (a -> b) -> a -> a -> c
    = Psi
end

let B a b c
    : (b -> c) -> (a -> b) -> a -> c
    = fn f ->
        fn g ->
            fn x ->
                f (g x)
            end
        end
    end
end

let comp a b c
    : (b -> c) -> (a -> b) -> a -> c
    = B
end

let B1 a b c d
    : (c -> d) -> (a -> b -> c) -> a -> b -> d
    = fn f ->
        fn g ->
            fn x ->
                fn y ->
                    f (g x y)
                end
            end
        end
    end
end

let comp2 a b c d
    : (c -> d) -> (a -> b -> c) -> a -> b -> d
    = B1
end

let B2 a b c d e
    : (d -> e) -> (a -> b -> c -> d) -> a -> b -> c -> e
    = fn f ->
        fn g ->
            fn x ->
                fn y ->
                    fn z ->
                        f (g x y z)
                    end
                end
            end
        end
    end
end

let comp3 a b c d e
    : (d -> e) -> (a -> b -> c -> d) -> a -> b -> c -> e
    = B2
end

let T a b
    : a -> (a -> b) -> b
    = fn x ->
        fn f ->
            f x
        end
    end
end

let thrust a b
    : a -> (a -> b) -> b
    = T
end

let W a b
    : (a -> a -> b) -> a -> b
    = fn f ->
        fn x ->
            f x x
        end
    end
end

let join a b
    : (a -> a -> b) -> a -> b
    = W
end

# ============================================================

# Product Helpers

# ============================================================

let pair a b
    : a -> b -> (a * b)
    = fn a ->
        fn b ->
            a * b
        end
    end
end

let fst a b
    : (a * b) -> a
    = match
        (x * y) -> x end
    end
end

let rst a b
    : (a * b) -> b
    = match
        (x * y) -> y end
    end
end

# ============================================================

# Boolean Helpers

# ============================================================

let not
    : Bool -> Bool
    = match
        Bool:True  -> Bool:False end
        Bool:False -> Bool:True  end
    end
end

let and
    : Bool -> Bool -> Bool
    = match
        Bool:True, Bool:True -> Bool:True  end
        _, _                 -> Bool:False end
    end
end

let or
    : Bool -> Bool -> Bool
    = match
        Bool:False, Bool:False -> Bool:False end
        _, _                   -> Bool:True  end
    end
end

let nor
    : Bool -> Bool -> Bool
    = comp2 not or
end

let nand
    : Bool -> Bool -> Bool
    = comp2 not and
end

let xor
    : Bool -> Bool -> Bool
    = fork (fork nor) and nor
end

let xnor
    : Bool -> Bool -> Bool
    = comp2 not xor
end

let cond a
    : Bool -> a -> a -> a
    = match
        Bool:True -> const       end
        Bool:False -> flip const end
    end
end

# ============================================================

# List Functions

# ============================================================

let filter a
    : (a -> Bool) -> List a -> List a
    = match
        _, [] -> [] end
        p, List:Cons (x * xs) ->
            cond (p x)
                (List:Cons (x * filter p xs))
                (filter p xs)
        end
    end
end

let foldl a b
    : (b -> a -> b) -> b -> List a -> b
    = match
        _, c, [] -> c end
        f, c, List:Cons (x * xs) ->
            foldl f (f c x) xs
        end
    end
end

let foldr a b
    : (a -> b -> b) -> b -> List a -> b
    = match
        f, z, [] -> z end
        f, z, List:Cons (x * xs) -> f x (foldr f z xs) end
    end
end

let scan a b
    : (b -> a -> b) -> b -> List a -> List b
    = match
        _, c, [] -> [c] end
        f, c, List:Cons (x * xs) ->
            List:Cons
                (c * scan f (f c x) xs)
        end
    end
end

let append a
    : List a -> List a -> List a
    = match
        [], ys -> ys end
        List:Cons (x * xs), ys ->
            List:Cons (x * append xs ys)
        end
    end
end

let concat
    : String -> String -> String
    = append
end

let len a
    : List a -> Int
    = foldl add 0 ~ map (const 1)
end

let reverse a
    : List a -> List a
    = foldl (flip < comp2 List:Cons pair) []
end

let take a
    : Int -> List a -> List a
    = match
        _, []           -> [] end
        n, List:Cons (x * xs) ->
            cond (lse n 0)
                []
                (List:Cons (x * take (pred n) xs))
        end
    end
end

let drop a
    : Int -> List a -> List a
    = match
        _, []                 -> [] end
        n, List:Cons (x * xs) ->
            cond (lse n 0)
                (List:Cons (x * xs))
                (drop (pred n) xs)
        end
    end
end

let take_while a
    : (a -> Bool) -> List a -> List a
    = match
        _, []           -> [] end
        p, List:Cons (x * xs) ->
            cond (p x)
               (List:Cons (x * take_while p xs))
               []
        end
    end
end

let zip a b
    : List a -> List b -> List (a * b)
    = zip_with pair
end

let zip_with a b c
    : (a -> b -> c) -> List a -> List b -> List c
    = match
        _, [], _ -> [] end
        _, _, [] -> [] end
        f, List:Cons (x * xs), List:Cons (y * ys) ->
            List:Cons (f x y * zip_with f xs ys)
        end
    end
end

let head a
    : List a -> Maybe a
    = match
        [] -> Maybe:Nil end
        List:Cons (x * _) -> Maybe:Val x end
    end
end

let tail a
    : List a -> Maybe (List a)
    = match
        [] -> Maybe:Nil end
        List:Cons (_ * xs) -> Maybe:Val xs end
    end
end

let index_of (a : Eqable)
    : List a -> a -> Maybe Int
    = flip (flip ~ index_of_from) 0
end

let index_of_from (a : Eqable)
    : List a -> a -> Int -> Maybe Int
    = match
        [], _, _ -> Maybe:Nil end
        List:Cons (y * ys), x, i ->
            cond (eq y x)
                (Maybe:Val i)
                (index_of_from ys x < succ i)
        end
    end
end

let repeat a
    : Int -> List a -> List a
    = fn n, s -> cond (lse n 0) [] (append s (repeat (pred n) s)) end
end

let flatten a
    : List (List a) -> List a
    = foldr append []
end

# ============================================================

# Maybe / Either

# ============================================================

let get_right a b
    : Either a b -> Maybe b
    = match
        Either:Right x -> Maybe:Val x end
        Either:Left _  -> Maybe:Nil end
    end
end

let map_nil a b
    : a -> Maybe b -> Either a b
    = match
        _, Maybe:Val x -> Either:Right x end
        d, Maybe:Nil -> Either:Left d end
    end
end

let or_else a
    : a -> Maybe a -> a
    = match
        _, Maybe:Val x -> x end
        d, Maybe:Nil -> d end
    end
end

# ============================================================

# Range Functions

# ============================================================

let range (a : Successable, Orderable)
    : a -> a -> List a
    = to ~ from
end

let range_inc (a : Successable, Orderable)
    : a -> a -> List a
    = to_inc ~ from
end

let from (a : Successable)
    : a -> List a
    = List:Cons ~ (ap pair < from ~ succ)
end

let to (a : Orderable)
    : List a -> a -> List a
    = flip < take_while ~ gr
end

let to_inc (a : Orderable)
    : List a -> a -> List a
    = flip < take_while ~ gre
end

# ============================================================

# IO Functions

# ============================================================

# Standard output. The standard error counterparts (`eputstr`, `eputstrln`, `eprint`,
# `eprintln`) are defined with the other process functions below.
let putstr
    : String -> IO Unit
    = undefined
end

let putstrln
    : String -> IO Unit
    = undefined
end

let getln
    : IO String
    = undefined
end

let print (a : Showable)
    : a -> IO Unit
    = putstr ~ show
end

let println (a : Showable)
    : a -> IO Unit
    = putstrln ~ show
end

let input (a : Parseable)
    : IO (Maybe a)
    = map parse getln
end

# ============================================================

# Type Classes

# ============================================================

class Addable a is
    let add
        : a -> a -> a
    end
end

class Subable a is
    let sub
        : a -> a -> a
    end
end

class Mulable a is
    let mul
        : a -> a -> a
    end
end

class Divable a is
    let div
        : a -> a -> a
    end
end

class Successable a is
    let succ
        : a -> a
    end

    let pred
        : a -> a
    end
end

class Orderable a is
    let gr
        : a -> a -> Bool
    end

    let gre
        : a -> a -> Bool
    end

    let ls
        : a -> a -> Bool
    end

    let lse
        : a -> a -> Bool
    end
end

let max (a : Orderable)
    : a -> a -> a
    = fn a, b -> cond (gr a b) a b end
end

let min (a : Orderable)
    : a -> a -> a
    = fn a, b -> cond (gr a b) b a end
end

let clamp (a : Orderable)
    : a -> a -> a -> a
    = fn lo, hi, v -> max lo < min hi v end
end

let abs (a : Orderable, Addable, Subable, Default)
    : a -> a
    = fn x -> cond (ls x default) (sub default x) x end
end

let neg (a : Subable, Default)
    : a -> a
    = sub default
end

class Eqable a is
    let eq
        : a -> a -> Bool
    end

    let neq
        : a -> a -> Bool
    end

end

class Showable a is
    let show
        : a -> String
    end
end

class Parseable a is
    let parse
        : String -> Maybe a
    end
end

class Functor f is
    let map a b
        : (a -> b) -> f a -> f b
    end
end

class Monad m is
    let return a
        : a -> m a
    end

    let bind a b
        : (a -> m b) -> m a -> m b
    end
end

# `a > then b` runs `a`, then `b` (pipe order): `then b a`.
let then (m : Monad) a b
    : m b -> m a -> m b
    = fork2 bind const id
end

let flat_map m a b
    : (a -> m b) -> m a -> m b
    = bind
end

class Default a is
    let default
        : a
    end
end

let is_default (a : Default)
    : a -> Bool
    = eq default
end

# ============================================================

# Default Instances

# ============================================================

instance Addable Int is
    let add
        : Int -> Int -> Int
        = undefined
    end
end

instance Subable Int is
    let sub
        : Int -> Int -> Int
        = undefined
    end
end

instance Mulable Int is
    let mul
        : Int -> Int -> Int
        = undefined
    end
end

instance Divable Int is
    let div
        : Int -> Int -> Int
        = undefined
    end
end

instance Eqable Int is
    let eq
        : Int -> Int -> Bool
        = undefined
    end

    let neq
        : Int -> Int -> Bool
        = undefined
    end

end

instance Orderable Int is
    let gr
        : Int -> Int -> Bool
        = undefined
    end

    let gre
        : Int -> Int -> Bool
        = undefined
    end

    let ls
        : Int -> Int -> Bool
        = undefined
    end

    let lse
        : Int -> Int -> Bool
        = undefined
    end

end

instance Successable Int is
    let succ
        : Int -> Int
        = add 1
    end

    let pred
        : Int -> Int
        = flip sub 1
    end
end

instance Showable Int is
    let show
        : Int -> String
        = undefined
    end
end

instance Showable Float is
    let show
        : Float -> String
        = undefined
    end
end

instance Showable String is
    let show
        : String -> String
        = id
    end
end

let parse_digit
    : Char -> Maybe Int
    = match
        '0' -> Maybe:Val 0 end
        '1' -> Maybe:Val 1 end
        '2' -> Maybe:Val 2 end
        '3' -> Maybe:Val 3 end
        '4' -> Maybe:Val 4 end
        '5' -> Maybe:Val 5 end
        '6' -> Maybe:Val 6 end
        '7' -> Maybe:Val 7 end
        '8' -> Maybe:Val 8 end
        '9' -> Maybe:Val 9 end
        _   -> Maybe:Nil end
    end
end

let parse_digits
    : Int -> String -> Maybe Int
    = match
        acc, [] -> Maybe:Val acc end
        acc, List:Cons (c * cs) ->
            bind (fn d -> parse_digits (add (mul acc 10) d) cs end) (parse_digit c)
        end
    end
end

let parse_nat
    : String -> Maybe Int
    = match
        [] -> Maybe:Nil end
        s  -> parse_digits 0 s end
    end
end

instance Parseable Int is
    let parse
        : String -> Maybe Int
        = match
            List:Cons ('-' * ds) -> map neg (parse_nat ds) end
            List:Cons ('+' * ds) -> parse_nat ds end
            s                    -> parse_nat s end
        end
    end
end

instance Functor List is
    let map a b
        : (a -> b) -> List a -> List b
        = match
            _, []                 -> []                         end
            f, List:Cons (x * xs) -> List:Cons (f x * map f xs) end
        end
    end
end

instance Functor Maybe is
    let map a b
        : (a -> b) -> Maybe a -> Maybe b
        = match
            _, Maybe:Nil -> Maybe:Nil end
            f, Maybe:Val x -> Maybe:Val (f x) end
        end
    end
end

instance Monad Maybe is
    let return a
        : a -> Maybe a
        = Maybe:Val
    end

    let bind a b
        : (a -> Maybe b) -> Maybe a -> Maybe b
        = match
            _, Maybe:Nil -> Maybe:Nil end
            f, Maybe:Val x -> f x end
        end
    end
end

instance Monad IO is
    let return a
        : a -> IO a
        = undefined
    end

    let bind a b
        : (a -> IO b) -> IO a -> IO b
        = undefined
    end
end

instance Default Int is let default : Int = 0 end end

instance Default Float is let default : Float = 0.0 end end

instance Default Bool is let default : Bool = Bool:False end end

instance Default String is let default : String = "" end end

instance Default (List a) is let default : List a = [] end end

instance Default (Maybe a) is let default : Maybe a = Maybe:Nil end end

# ============================================================
# Float and Char instances
# ============================================================

instance Addable Float is
    let add
        : Float -> Float -> Float
        = undefined
    end
end

instance Subable Float is
    let sub
        : Float -> Float -> Float
        = undefined
    end
end

instance Mulable Float is
    let mul
        : Float -> Float -> Float
        = undefined
    end
end

instance Divable Float is
    let div
        : Float -> Float -> Float
        = undefined
    end
end

instance Eqable Float is
    let eq
        : Float -> Float -> Bool
        = undefined
    end
    let neq
        : Float -> Float -> Bool
        = undefined
    end
end

instance Orderable Float is
    let gr
        : Float -> Float -> Bool
        = undefined
    end
    let gre
        : Float -> Float -> Bool
        = undefined
    end
    let ls
        : Float -> Float -> Bool
        = undefined
    end
    let lse
        : Float -> Float -> Bool
        = undefined
    end
end

instance Eqable Char is
    let eq
        : Char -> Char -> Bool
        = undefined
    end
    let neq
        : Char -> Char -> Bool
        = undefined
    end
end

instance Orderable Char is
    let gr
        : Char -> Char -> Bool
        = undefined
    end
    let gre
        : Char -> Char -> Bool
        = undefined
    end
    let ls
        : Char -> Char -> Bool
        = undefined
    end
    let lse
        : Char -> Char -> Bool
        = undefined
    end
end

instance Eqable Bool is
    let eq
        : Bool -> Bool -> Bool
        = match
            Bool:True, Bool:True -> Bool:True end
            Bool:False, Bool:False -> Bool:True end
            _, _ -> Bool:False end
        end
    end
    let neq
        : Bool -> Bool -> Bool
        = match
            Bool:True, Bool:True -> Bool:False end
            Bool:False, Bool:False -> Bool:False end
            _, _ -> Bool:True end
        end
    end
end

# ============================================================
# More instances
#
# Every class gets an instance for each type a user would expect it for. Instances are
# resolved by the head of the type, so `List a` also serves `String`, and a constraint on a
# method (`(a : Eqable)`) is resolved at each concrete type the method is used at.
# Not provided: `Default Unit` and `Parseable Unit` (the language has no unit literal),
# and, because they need compiler primitives, `Successable Char` (no Char <-> Int
# conversion).
# ============================================================

# ---- Nat helpers ----

let nat_to_int
    : Nat -> Int
    = match
        Nat:Zero   -> 0 end
        Nat:Succ n -> succ (nat_to_int n) end
    end
end

let int_to_nat
    : Int -> Nat
    = match
        n -> cond (lse n 0) Nat:Zero (Nat:Succ (int_to_nat (pred n))) end
    end
end

let float_digit
    : Int -> Float
    = match
        n -> cond (lse n 0) 0.0 (succ (float_digit (pred n))) end
    end
end

# ---- Addable / Subable / Mulable / Divable ----

instance Addable (List a) is
    let add a
        : List a -> List a -> List a
        = append
    end
end

instance Addable Nat is
    let add
        : Nat -> Nat -> Nat
        = match
            Nat:Zero, m   -> m end
            Nat:Succ n, m -> Nat:Succ (add n m) end
        end
    end
end

instance Subable Nat is
    let sub
        : Nat -> Nat -> Nat
        = match
            n, Nat:Zero                -> n end
            Nat:Zero, _                -> Nat:Zero end
            Nat:Succ n, Nat:Succ m     -> sub n m end
        end
    end
end

instance Mulable Nat is
    let mul
        : Nat -> Nat -> Nat
        = match
            Nat:Zero, _   -> Nat:Zero end
            Nat:Succ n, m -> add m (mul n m) end
        end
    end
end

# ---- Successable ----

instance Successable Float is
    let succ
        : Float -> Float
        = add 1.0
    end
    let pred
        : Float -> Float
        = flip sub 1.0
    end
end

instance Successable Nat is
    let succ
        : Nat -> Nat
        = Nat:Succ
    end
    let pred
        : Nat -> Nat
        = match
            Nat:Zero   -> Nat:Zero end
            Nat:Succ n -> n end
        end
    end
end

instance Successable Bool is
    let succ
        : Bool -> Bool
        = const Bool:True
    end
    let pred
        : Bool -> Bool
        = const Bool:False
    end
end

# ---- Eqable ----

instance Eqable Unit is
    let eq
        : Unit -> Unit -> Bool
        = const (const Bool:True)
    end
    let neq
        : Unit -> Unit -> Bool
        = const (const Bool:False)
    end
end


instance Eqable Nat is
    let eq
        : Nat -> Nat -> Bool
        = match
            Nat:Zero, Nat:Zero         -> Bool:True end
            Nat:Succ n, Nat:Succ m     -> eq n m end
            _, _                       -> Bool:False end
        end
    end
    let neq
        : Nat -> Nat -> Bool
        = comp2 not eq
    end
end

instance Eqable (Maybe a) is
    let eq (a : Eqable)
        : Maybe a -> Maybe a -> Bool
        = match
            Maybe:Nil, Maybe:Nil       -> Bool:True end
            Maybe:Val x, Maybe:Val y   -> eq x y end
            _, _                       -> Bool:False end
        end
    end
    let neq (a : Eqable)
        : Maybe a -> Maybe a -> Bool
        = comp2 not eq
    end
end

instance Eqable (List a) is
    let eq (a : Eqable)
        : List a -> List a -> Bool
        = match
            [], []                                 -> Bool:True end
            List:Cons (x * xs), List:Cons (y * ys) -> and (eq x y) (eq xs ys) end
            _, _                                   -> Bool:False end
        end
    end
    let neq (a : Eqable)
        : List a -> List a -> Bool
        = comp2 not eq
    end
end

instance Eqable (Either a b) is
    let eq (a : Eqable) (b : Eqable)
        : Either a b -> Either a b -> Bool
        = match
            Either:Left x, Either:Left y     -> eq x y end
            Either:Right x, Either:Right y   -> eq x y end
            _, _                             -> Bool:False end
        end
    end
    let neq (a : Eqable) (b : Eqable)
        : Either a b -> Either a b -> Bool
        = comp2 not eq
    end
end

instance Eqable (a * b) is
    let eq (a : Eqable) (b : Eqable)
        : (a * b) -> (a * b) -> Bool
        = match
            (x * y), (z * w) -> and (eq x z) (eq y w) end
        end
    end
    let neq (a : Eqable) (b : Eqable)
        : (a * b) -> (a * b) -> Bool
        = comp2 not eq
    end
end

instance Eqable (a + b) is
    let eq (a : Eqable) (b : Eqable)
        : (a + b) -> (a + b) -> Bool
        = match
            (x +), (y +) -> eq x y end
            (+ x), (+ y) -> eq x y end
            _, _         -> Bool:False end
        end
    end
    let neq (a : Eqable) (b : Eqable)
        : (a + b) -> (a + b) -> Bool
        = comp2 not eq
    end
end

# ---- Orderable (False < True, Nil < Val, shorter prefix first, Left < Right) ----

instance Orderable Unit is
    let gr
        : Unit -> Unit -> Bool
        = const (const Bool:False)
    end
    let gre
        : Unit -> Unit -> Bool
        = const (const Bool:True)
    end
    let ls
        : Unit -> Unit -> Bool
        = const (const Bool:False)
    end
    let lse
        : Unit -> Unit -> Bool
        = const (const Bool:True)
    end
end

instance Orderable Bool is
    let gr
        : Bool -> Bool -> Bool
        = match
            Bool:True, Bool:False -> Bool:True end
            _, _                  -> Bool:False end
        end
    end
    let gre
        : Bool -> Bool -> Bool
        = match
            Bool:False, Bool:True -> Bool:False end
            _, _                  -> Bool:True end
        end
    end
    let ls
        : Bool -> Bool -> Bool
        = flip gr
    end
    let lse
        : Bool -> Bool -> Bool
        = flip gre
    end
end

instance Orderable Nat is
    let gr
        : Nat -> Nat -> Bool
        = match
            Nat:Succ _, Nat:Zero       -> Bool:True end
            Nat:Succ n, Nat:Succ m     -> gr n m end
            _, _                       -> Bool:False end
        end
    end
    let gre
        : Nat -> Nat -> Bool
        = match
            Nat:Succ n, Nat:Succ m     -> gre n m end
            Nat:Zero, Nat:Succ _       -> Bool:False end
            _, _                       -> Bool:True end
        end
    end
    let ls
        : Nat -> Nat -> Bool
        = flip gr
    end
    let lse
        : Nat -> Nat -> Bool
        = flip gre
    end
end

instance Orderable (Maybe a) is
    let gr (a : Orderable)
        : Maybe a -> Maybe a -> Bool
        = match
            Maybe:Val x, Maybe:Val y   -> gr x y end
            Maybe:Val _, Maybe:Nil     -> Bool:True end
            _, _                       -> Bool:False end
        end
    end
    let gre (a : Orderable)
        : Maybe a -> Maybe a -> Bool
        = match
            Maybe:Val x, Maybe:Val y   -> gre x y end
            Maybe:Nil, Maybe:Val _     -> Bool:False end
            _, _                       -> Bool:True end
        end
    end
    let ls (a : Orderable)
        : Maybe a -> Maybe a -> Bool
        = flip gr
    end
    let lse (a : Orderable)
        : Maybe a -> Maybe a -> Bool
        = flip gre
    end
end

instance Orderable (List a) is
    let gr (a : Orderable, Eqable)
        : List a -> List a -> Bool
        = match
            List:Cons (x * xs), List:Cons (y * ys) ->
                cond (eq x y) (gr xs ys) (gr x y)
            end
            List:Cons _, [] -> Bool:True end
            _, _            -> Bool:False end
        end
    end
    let gre (a : Orderable, Eqable)
        : List a -> List a -> Bool
        = match
            List:Cons (x * xs), List:Cons (y * ys) ->
                cond (eq x y) (gre xs ys) (gr x y)
            end
            [], List:Cons _ -> Bool:False end
            _, _                  -> Bool:True end
        end
    end
    let ls (a : Orderable, Eqable)
        : List a -> List a -> Bool
        = flip gr
    end
    let lse (a : Orderable, Eqable)
        : List a -> List a -> Bool
        = flip gre
    end
end

instance Orderable (a * b) is
    let gr (a : Orderable, Eqable) (b : Orderable)
        : (a * b) -> (a * b) -> Bool
        = match
            (x * y), (z * w) -> cond (eq x z) (gr y w) (gr x z) end
        end
    end
    let gre (a : Orderable, Eqable) (b : Orderable)
        : (a * b) -> (a * b) -> Bool
        = match
            (x * y), (z * w) -> cond (eq x z) (gre y w) (gr x z) end
        end
    end
    let ls (a : Orderable, Eqable) (b : Orderable)
        : (a * b) -> (a * b) -> Bool
        = flip gr
    end
    let lse (a : Orderable, Eqable) (b : Orderable)
        : (a * b) -> (a * b) -> Bool
        = flip gre
    end
end

# ---- Showable ----

instance Showable Char is
    let show
        : Char -> String
        = fn c -> ['\'', c, '\''] end
    end
end

instance Showable Unit is
    let show
        : Unit -> String
        = const "()"
    end
end

instance Showable Bool is
    let show
        : Bool -> String
        = match
            Bool:True  -> "True" end
            Bool:False -> "False" end
        end
    end
end

instance Showable Nat is
    let show
        : Nat -> String
        = show ~ nat_to_int
    end
end

# `[1, 2, 3]`; strings use the more specific `Showable String` instance
let show_items (a : Showable)
    : List a -> String
    = match
        []                 -> "" end
        List:Cons (x * []) -> show x end
        List:Cons (x * xs) -> concat (show x) (concat ", " (show_items xs)) end
    end
end

instance Showable (List a) is
    let show (a : Showable)
        : List a -> String
        = match
            xs -> concat "[" (concat (show_items xs) "]") end
        end
    end
end

instance Showable (Maybe a) is
    let show (a : Showable)
        : Maybe a -> String
        = match
            Maybe:Nil   -> "Nil" end
            Maybe:Val x -> concat "Val " (show x) end
        end
    end
end

instance Showable (Either a b) is
    let show (a : Showable) (b : Showable)
        : Either a b -> String
        = match
            Either:Left x  -> concat "Left " (show x) end
            Either:Right x -> concat "Right " (show x) end
        end
    end
end

instance Showable (a * b) is
    let show (a : Showable) (b : Showable)
        : (a * b) -> String
        = match
            (x * y) -> concat "(" (concat (show x) (concat ", " (concat (show y) ")"))) end
        end
    end
end

instance Showable (a + b) is
    let show (a : Showable) (b : Showable)
        : (a + b) -> String
        = match
            (x +) -> concat "left " (show x) end
            (+ y) -> concat "right " (show y) end
        end
    end
end

# ---- Parseable ----

instance Parseable String is
    let parse
        : String -> Maybe String
        = Maybe:Val
    end
end

instance Parseable Nat is
    let parse
        : String -> Maybe Nat
        = map int_to_nat ~ parse_nat
    end
end

instance Parseable Char is
    let parse
        : String -> Maybe Char
        = match
            List:Cons (c * []) -> Maybe:Val c end
            _   -> Maybe:Nil end
        end
    end
end

instance Parseable Bool is
    let parse
        : String -> Maybe Bool
        = match
            s -> cond (eq s "True") (Maybe:Val Bool:True)
                (cond (eq s "False") (Maybe:Val Bool:False) Maybe:Nil) end
        end
    end
end

# Float: [+-] digits [. digits]
let float_digit_of
    : Char -> Maybe Float
    = map float_digit ~ parse_digit
end

let parse_float_frac
    : Float -> Float -> String -> Maybe Float
    = match
        _, acc, [] -> Maybe:Val acc end
        scale, acc, List:Cons (c * cs) ->
            bind (fn d -> parse_float_frac (div scale 10.0) (add acc (mul scale d)) cs end)
                 (float_digit_of c)
        end
    end
end

let parse_float_int
    : Float -> String -> Maybe Float
    = match
        acc, [] -> Maybe:Val acc end
        acc, List:Cons ('.' * cs) -> parse_float_frac 0.1 acc cs end
        acc, List:Cons (c * cs) ->
            bind (fn d -> parse_float_int (add (mul acc 10.0) d) cs end) (float_digit_of c)
        end
    end
end

let parse_float_unsigned
    : String -> Maybe Float
    = match
        [] -> Maybe:Nil end
        s  -> parse_float_int 0.0 s end
    end
end

instance Parseable Float is
    let parse
        : String -> Maybe Float
        = match
            List:Cons ('-' * ds) -> map neg (parse_float_unsigned ds) end
            List:Cons ('+' * ds) -> parse_float_unsigned ds end
            s                    -> parse_float_unsigned s end
        end
    end
end

# ---- Functor / Monad ----

instance Functor IO is
    let map a b
        : (a -> b) -> IO a -> IO b
        = bind ~ (return ~)
    end
end

instance Functor (Either e) is
    let map a b
        : (a -> b) -> Either e a -> Either e b
        = match
            _, Either:Left x -> Either:Left x end
            f, Either:Right x -> Either:Right (f x) end
        end
    end
end

instance Monad (Either e) is
    let return a
        : a -> Either e a
        = Either:Right
    end
    let bind a b
        : (a -> Either e b) -> Either e a -> Either e b
        = match
            _, Either:Left x  -> Either:Left x end
            f, Either:Right x -> f x end
        end
    end
end

instance Monad List is
    let return a
        : a -> List a
        = fn x -> [x] end
    end
    let bind a b
        : (a -> List b) -> List a -> List b
        = flip foldr [] ~ (append ~)
    end
end

# ---- Default ----

instance Default Char is let default : Char = ' ' end end

instance Default Nat is let default : Nat = Nat:Zero end end

instance Default (a * b) is
    let default (a : Default) (b : Default)
        : (a * b)
        = (default * default)
    end
end

# ============================================================

# Anonymous sums:  (a + b)

# ============================================================

let left a b
    : a -> (a + b)
    = undefined
end

let right a b
    : b -> (a + b)
    = undefined
end

let sum_case a b c
    : (a -> c) -> (b -> c) -> (a + b) -> c
    = match
        f, _, (x +) -> f x end
        _, g, (+ y) -> g y end
    end
end

# ============================================================

# Conversions and bit operations

# ============================================================

# The one value of `Unit`.
let unit
    : Unit
    = undefined
end

# Unicode code point of a character, and back.
let ord
    : Char -> Int
    = undefined
end

let chr
    : Int -> Char
    = undefined
end

let int_to_float
    : Int -> Float
    = undefined
end

# Truncates toward zero; saturates at the Int range; NaN is 0.
let float_to_int
    : Float -> Int
    = undefined
end

# The shortest text that reads back as exactly this Float ("0.1", "1234567.89", "1e+22").
# Unlike `show`, which keeps 6 digits, nothing is lost. "nan", "inf" and "-inf" for the rest.
let float_repr
    : Float -> String
    = undefined
end

let bit_and
    : Int -> Int -> Int
    = undefined
end

let bit_or
    : Int -> Int -> Int
    = undefined
end

let bit_xor
    : Int -> Int -> Int
    = undefined
end

# `shift_left x n`: the shift amount is taken mod 32.
let shift_left
    : Int -> Int -> Int
    = undefined
end

# logical (zero filling)
let shift_right
    : Int -> Int -> Int
    = undefined
end

# arithmetic (sign extending)
let shift_right_arith
    : Int -> Int -> Int
    = undefined
end

let bit_not
    : Int -> Int
    = flip bit_xor -1
end

instance Successable Char is
    let succ
        : Char -> Char
        = chr ~ succ ~ ord
    end
    let pred
        : Char -> Char
        = chr ~ pred ~ ord
    end
end

# ============================================================

# Errors from the operating system

# ============================================================

type IOError = NotFound String + PermissionDenied String + AlreadyExists String + IsADirectory String + NotADirectory String + DirectoryNotEmpty String + InvalidInput String + OtherError String + UnexpectedEof String
end

let io_error_message
    : IOError -> String
    = match
        IOError:NotFound m          -> concat "not found: " m end
        IOError:PermissionDenied m  -> concat "permission denied: " m end
        IOError:AlreadyExists m     -> concat "already exists: " m end
        IOError:IsADirectory m      -> concat "is a directory: " m end
        IOError:NotADirectory m     -> concat "not a directory: " m end
        IOError:DirectoryNotEmpty m -> concat "directory not empty: " m end
        IOError:InvalidInput m      -> concat "invalid input: " m end
        IOError:OtherError m        -> m end
        IOError:UnexpectedEof m     -> concat "unexpected end of input: " m end
    end
end

instance Showable IOError is
    let show
        : IOError -> String
        = io_error_message
    end
end

let io_error_of
    : Int -> String -> IOError
    = match
        1, m -> IOError:NotFound m end
        2, m -> IOError:PermissionDenied m end
        3, m -> IOError:AlreadyExists m end
        4, m -> IOError:IsADirectory m end
        5, m -> IOError:NotADirectory m end
        6, m -> IOError:DirectoryNotEmpty m end
        7, m -> IOError:InvalidInput m end
        9, m -> IOError:UnexpectedEof m end
        _, m -> IOError:OtherError m end
    end
end

# The runtime answers a fallible request with one string: the first character is a status
# code (0 = success) and the rest is the payload, or the error message.
let io_decode
    : String -> Either IOError String
    = match
        []                 -> Either:Left (IOError:OtherError "no answer from the runtime") end
        List:Cons (c * cs) ->
            cond (eq (ord c) 0)
                (Either:Right cs)
                (Either:Left (io_error_of (ord c) cs))
        end
    end
end

let io_decode_unit
    : String -> Either IOError Unit
    = map (const unit) ~ io_decode
end

# ============================================================

# Files

# ============================================================

# Raw runtime primitives (see src/rtprims.rs). The Int is a mode: bit 0 = bytes instead of
# UTF-8, bit 1 = append.

let prim_fs_read
    : String -> Int -> IO String
    = undefined
end

let prim_fs_write
    : String -> String -> Int -> IO String
    = undefined
end

# 0 = missing, 1 = file, 2 = directory, 3 = something else
let prim_fs_kind
    : String -> IO Int
    = undefined
end

let prim_fs_stat
    : String -> IO String
    = undefined
end

let prim_fs_remove
    : String -> IO String
    = undefined
end

let prim_fs_mkdir
    : String -> IO String
    = undefined
end

let prim_fs_list
    : String -> IO String
    = undefined
end

let prim_fs_rename
    : String -> String -> IO String
    = undefined
end

let prim_fs_cwd
    : IO String
    = undefined
end

let prim_fs_chdir
    : String -> IO String
    = undefined
end

let prim_fs_realpath
    : String -> IO String
    = undefined
end

# The whole file as text (decoded from UTF-8; malformed bytes become U+FFFD).
let read_file
    : String -> IO (Either IOError String)
    = fn path -> map io_decode (prim_fs_read path 0) end
end

# Replaces the file's contents (creating it if needed), encoding as UTF-8.
let write_file
    : String -> String -> IO (Either IOError Unit)
    = fn path -> fn text -> map io_decode_unit (prim_fs_write path text 0) end end
end

let append_file
    : String -> String -> IO (Either IOError Unit)
    = fn path -> fn text -> map io_decode_unit (prim_fs_write path text 2) end end
end

# Binary variants: every Char is one byte (0..255).
let read_file_bytes
    : String -> IO (Either IOError String)
    = fn path -> map io_decode (prim_fs_read path 1) end
end

let write_file_bytes
    : String -> String -> IO (Either IOError Unit)
    = fn path -> fn bytes -> map io_decode_unit (prim_fs_write path bytes 1) end end
end

let append_file_bytes
    : String -> String -> IO (Either IOError Unit)
    = fn path -> fn bytes -> map io_decode_unit (prim_fs_write path bytes 3) end end
end

# True for a file, a directory, or anything else that exists.
let file_exists
    : String -> IO Bool
    = map (neq 0) ~ prim_fs_kind
end

let is_file
    : String -> IO Bool
    = map (eq 1) ~ prim_fs_kind
end

let is_dir
    : String -> IO Bool
    = map (eq 2) ~ prim_fs_kind
end

# ============================================================

# The process: arguments, exit codes, standard streams

# ============================================================

let prim_sys_args
    : IO String
    = undefined
end

# never returns, so its result can be any type
let prim_sys_exit a
    : Int -> IO a
    = undefined
end

let prim_sys_getenv
    : String -> IO String
    = undefined
end

let prim_sys_environ
    : IO String
    = undefined
end

let prim_sys_pid
    : IO Int
    = undefined
end

let prim_io_flush
    : IO Unit
    = undefined
end

let prim_io_eprint
    : String -> Int -> IO Unit
    = undefined
end

let prim_io_stdin_all
    : IO String
    = undefined
end

let prim_io_getln_opt
    : IO String
    = undefined
end

# "a\0b\0" -> ["a", "b"]
let split_nuls
    : String -> List String
    = match
        [] -> [] end
        s  -> List:Cons (take_while (fn c -> neq (ord c) 0 end) s * split_nuls (drop_past_nul s)) end
    end
end

let drop_past_nul
    : String -> String
    = match
        []                 -> [] end
        List:Cons (c * cs) -> cond (eq (ord c) 0) cs (drop_past_nul cs) end
    end
end

# The command line arguments, without the program name.
let args
    : IO (List String)
    = map split_nuls prim_sys_args
end

# Runs the rest of the program only after `main` has been given the arguments: the compiler
# wraps an entry point of type `List String -> IO a` with this.
let with_args a
    : (List String -> IO a) -> IO a
    = fn f -> bind f args end
end

# Ends the program at once with this exit status (output is flushed first). Usually
# `main : IO Int` returning the status is all you need; this is for bailing out of the
# middle of a program.
let exit
    : Int -> IO Unit
    = prim_sys_exit
end

let flush
    : IO Unit
    = prim_io_flush
end

# Standard error mirrors standard output: `eputstr`/`eputstrln` take a String like
# `putstr`/`putstrln`, and `eprint`/`eprintln` take anything Showable like `print`/`println`.
let eputstr
    : String -> IO Unit
    = fn s -> prim_io_eprint s 0 end
end

let eputstrln
    : String -> IO Unit
    = fn s -> prim_io_eprint s 1 end
end

let eprint (a : Showable)
    : a -> IO Unit
    = eputstr ~ show
end

let eprintln (a : Showable)
    : a -> IO Unit
    = eputstrln ~ show
end

# One line of input, or `Nil` once the input has ended.
let read_line
    : IO (Maybe String)
    = map (get_right ~ io_decode) prim_io_getln_opt
end

# Everything left on standard input.
let read_stdin
    : IO String
    = prim_io_stdin_all
end

# An environment variable.
let get_env
    : String -> IO (Maybe String)
    = map (get_right ~ io_decode) ~ prim_sys_getenv
end

# ============================================================

# Hashing (for HashMap and HashSet)

# ============================================================

# `eq x y` must imply `hash x == hash y`. Any Int is a valid hash.
class Hashable a is
    let hash
        : a -> Int
    end
end

# murmur3's 32-bit finalizer: spreads every input bit over the whole result.
let hash_mix
    : Int -> Int
    = mix5 ~ mix4 ~ mix3 ~ mix2 ~ mix1
with mix1
    : Int -> Int
    = fn h -> bit_xor h (shift_right h 16) end
with mix2
    : Int -> Int
    = flip mul -2048144789
with mix3
    : Int -> Int
    = fn h -> bit_xor h (shift_right h 13) end
with mix4
    : Int -> Int
    = flip mul -1028477387
with mix5
    : Int -> Int
    = fn h -> bit_xor h (shift_right h 16) end
end

# Folds a second hash into a first (order matters).
let hash_combine
    : Int -> Int -> Int
    = fn a, b -> add (mul a 1000003) b end
end

instance Hashable Int is
    let hash
        : Int -> Int
        = hash_mix
    end
end

instance Hashable Char is
    let hash
        : Char -> Int
        = hash_mix ~ ord
    end
end

instance Hashable Bool is
    let hash
        : Bool -> Int
        = match
            Bool:True  -> 1 end
            Bool:False -> 0 end
        end
    end
end

instance Hashable Unit is
    let hash
        : Unit -> Int
        = const 0
    end
end

instance Hashable Float is
    let hash
        : Float -> Int
        = fn x ->
            hash_mix < hash_combine (float_to_int x) (float_to_int < mul (sub x < int_to_float < float_to_int x) 1000000.0)
        end
    end
end

instance Hashable (List a) is
    let hash (a : Hashable)
        : List a -> Int
        = fn xs -> hash_mix (foldl (fn acc, x -> hash_combine acc < hash x end) 7 xs) end
    end
end

instance Hashable (Maybe a) is
    let hash (a : Hashable)
        : Maybe a -> Int
        = match
            Maybe:Nil   -> 11 end
            Maybe:Val x -> hash_combine 13 < hash x end
        end
    end
end

instance Hashable (a * b) is
    let hash (a : Hashable) (b : Hashable)
        : (a * b) -> Int
        = match
            (x * y) -> hash_mix < hash_combine (hash x) (hash y) end
        end
    end
end

instance Hashable (Either a b) is
    let hash (a : Hashable) (b : Hashable)
        : Either a b -> Int
        = match
            Either:Left x  -> hash_combine 17 (hash x) end
            Either:Right y -> hash_combine 19 (hash y) end
        end
    end
end

# Chains fallible IO: runs the second action with the first one's result, or stops at the
# first error.
#
#     read_file "in.txt" > io_and_then (fn text -> write_file "out.txt" text end)
let io_and_then a b e
    : (a -> IO (Either e b)) -> IO (Either e a) -> IO (Either e b)
    = fn f -> bind (match
        Either:Left x  -> return (Either:Left x) end
        Either:Right v -> f v end
      end) end
end
