module Main is

let main
    : IO Unit
    = println "Enter a number:" > then
    < getln > bind fn num ->
        println < output num
    end
with output
    : String -> String
    = fork concat (flip concat " is ") parity
with parity
    : String -> String
    = fn s -> cond (even (parse_or_default s)) "Even" "Odd" end
with even
    : Int -> Bool
    = eq 0 ~ flip mod 2
with parse_or_default (a : Parseable, Default)
    : String -> a
    = or_else default ~ parse
end
