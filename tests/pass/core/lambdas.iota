# multi-argument lambdas, partial application and closures
# out: 6
# out: 13
# out: 7
# out: [11, 12]
# out: 11
module Main is

let add3
    : Int -> Int -> Int -> Int
    = fn a, b, c -> add a (add b c) end
end

let adder
    : Int -> Int -> Int
    = fn x -> fn y -> add x y end end
end

let make_counter
    : Int -> Int -> Int
    = fn start -> fn step -> add start step end end
end

let main
    : IO Unit
    = println (add3 1 2 3)            > then
    < println ((add3 1 2) 10)         > then
    < println (adder 3 4)             > then
    < println (map (adder 10) [1, 2]) > then
    < println (make_counter 5 6)
end
