# patterns on the sum type (a + b)
# out: number 42
# out: string hello
module Main is

let describe
    : (Int + String) -> String
    = match
        (_ +) -> concat "number " ~ show end
        (+ _) -> concat "string " end
    end
end

let main
    : IO Unit
    = println (describe (left 42)) > then
    < println (describe (right "hello"))
end
