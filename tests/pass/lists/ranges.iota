# ranges and generators
# out: [1, 2, 3, 4]
# out: [1, 2, 3, 4]
# out: []
# out: [7, 7, 7]
# out: [10, 11, 12]
# out: 1000
module Main is

let main
    : IO Unit
    = println (range 1 5)        > then
    < println (range_inc 1 4)    > then
    < println (range 3 3)        > then
    < println (repeat 3 [7])     > then
    < println (take 3 (from 10)) > then
    < println (len (range 0 1000))
end
