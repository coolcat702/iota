# the list functions of the prelude
# out: [2, 4, 6, 8]
# out: [2, 4]
# out: 6
# out: 6
# out: [1, 2, 3]
# out: [3, 2, 1]
# out: [1, 2]
# out: [3]
# out: [1, 2]
# out: [(1, 3), (2, 4)]
# out: [4, 6]
# out: 3
# out: [1, 2, 3]
module Main is

let main
    : IO Unit
    = println (map (mul 2) [1, 2, 3, 4])                > then
    < println (filter (eq 0 ~ flip mod 2) [1, 2, 3, 4]) > then
    < println (foldl add 0 [1, 2, 3])                   > then
    < println (foldr add 0 [1, 2, 3])                   > then
    < println (append [1, 2] [3])                       > then
    < println (reverse [1, 2, 3])                       > then
    < println (take 2 [1, 2, 3])                        > then
    < println (drop 2 [1, 2, 3])                        > then
    < println (take_while (gr 3) [1, 2, 3, 4])          > then
    < println (zip [1, 2] [3, 4])                       > then
    < println (zip_with add [1, 2] [3, 4])              > then
    < println (len [5, 6, 7])                           > then
    < println (flatten [[1], [2, 3]])
end
