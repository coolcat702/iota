# std/str.iota
# out: ABC
# out: abc
# out: a, b, c
# out: hi
# out: True
# out: True
# out: True
# out: Val 3
# out: [a, b, c]
# out: bcd
# out: True
module Main is

import file std/str.iota

let main
    : IO Unit
    = println (Str:to_upper "abc") > then
    < println (Str:to_lower "ABC") > then
    < println (Str:join ", " ["a", "b", "c"]) > then
    < println (Str:trim "  hi  ") > then
    < println (Str:starts_with "ab" "abc") > then
    < println (Str:ends_with "bc" "abc") > then
    < println (Str:contains "lo w" "hello world") > then
    < println (Str:find "lo" "hello") > then
    < println (Str:split_by (eq ',') "a,b,c") > then
    < println (Str:substring 1 3 "abcdef") > then
    < println (Str:is_digit '7')
end
