module Time is

# Clocks, sleeping, and calendar dates (proleptic Gregorian, UTC unless it says "local").
#
#     import file std/time.iota
#
# Times are `Float` seconds, which is exact to the microsecond for dates well past 2100 (an
# `Int` would overflow in 2038).
#
#     bind (fn t -> println (Time:format "%Y-%m-%d %H:%M:%S" (Time:from_unix t)) end) Time:now

import file std/str.iota

let prim_unix
    : IO Float
    = undefined
end

let prim_mono
    : IO Float
    = undefined
end

let prim_offset
    : Float -> IO Int
    = undefined
end

let prim_sleep
    : Int -> IO Unit
    = undefined
end

# ---- clocks ----

# Seconds since 1970-01-01 00:00:00 UTC. The wall clock can jump (NTP, the user); don't
# use it to measure how long something took.
let now
    : IO Float
    = prim_unix
end

# Seconds from an arbitrary starting point that only moves forward. Use it for timing.
let monotonic
    : IO Float
    = prim_mono
end

# Pauses for this many milliseconds.
let sleep_ms
    : Int -> IO Unit
    = prim_sleep
end

let sleep
    : Float -> IO Unit
    = comp prim_sleep (comp float_to_int < mul 1000.0)
end

# Runs an action and also returns how many seconds it took.
let measure a
    : IO a -> IO (a * Float)
    = fn action -> monotonic >
        bind < fn t0 -> action >
            bind < fn result -> monotonic >
                bind < fn t1 -> return (result * sub t1 t0) end
            end
        end
    end
end

# ---- calendar ----

# year, month (1-12), day (1-31), hour, minute, second
type DateTime = Int * (Int * (Int * (Int * (Int * Int))))
end

let make
    : Int -> Int -> Int -> Int -> Int -> Int -> DateTime
    = fn y, mo, d, h, mi, s -> (y * (mo * (d * (h * (mi * s))))) end
end

let year
    : DateTime -> Int
    = fst
end

let month
    : DateTime -> Int
    = comp fst rst
end

let day
    : DateTime -> Int
    = comp (comp fst rst) rst
end

let hour
    : DateTime -> Int
    = comp (comp (comp fst rst) rst) rst
end

let minute
    : DateTime -> Int
    = comp (comp (comp (comp fst rst) rst) rst) rst
end

let second
    : DateTime -> Int
    = comp (comp (comp (comp rst rst) rst) rst) rst
end

let is_leap_year
    : Int -> Bool
    = fn y -> or (and (eq (mod y 4) 0) (neq (mod y 100) 0)) (eq (mod y 400) 0) end
end

let days_in_month
    : Int -> Int -> Int
    = fn y, m ->
        cond (eq m 2)
            (cond (is_leap_year y) 29 28)
            (cond (or (or (eq m 4) (eq m 6)) (or (eq m 9) (eq m 11))) 30 31)
    end
end

# Days since 1970-01-01 of a civil date (Howard Hinnant's algorithm; exact for any year).
let days_from_civil
    : Int -> Int -> Int -> Int
    = fn y0, m, d ->
        days_from_civil_era (div (cond (lse m 2) (sub y0 1) y0) 400) (cond (lse m 2) (sub y0 1) y0) m d
    end
end

let days_from_civil_era
    : Int -> Int -> Int -> Int -> Int
    = fn era, y, m, d -> days_from_civil_doe era (sub y < mul era 400)
        < add (pred d) < div (add 2 < mul 153 < cond (gr m 2) (sub m 3) (add m 9)) 5
    end
end

let days_from_civil_doe
    : Int -> Int -> Int -> Int
    = fn era, yoe, doy ->
        sub (add (mul era 146097) (sub (add doy < add (mul yoe 365) < div yoe 4) < div yoe 100)) 719468
    end
end

# The civil date of a day count since 1970-01-01: (year, month, day).
let civil_from_days
    : Int -> (Int * (Int * Int))
    = fn z0 -> civil_era (div (add z0 719468) 146097) (add z0 719468) end
end

let civil_era
    : Int -> Int -> (Int * (Int * Int))
    = fn era, z -> civil_doe era (sub z < mul era 146097) end
end

let civil_doe
    : Int -> Int -> (Int * (Int * Int))
    = fn era, doe ->
        civil_yoe era doe
            (div (sub (add (sub doe < div doe 1460) < div doe 36524) < div doe 146096) 365)
    end
end

let civil_yoe
    : Int -> Int -> Int -> (Int * (Int * Int))
    = fn era, doe, yoe ->
        civil_final (add yoe (mul era 400)) < sub doe < sub (add (mul 365 yoe) < div yoe 4) < div yoe 100
    end
end

let civil_final
    : Int -> Int -> (Int * (Int * Int))
    = fn y, doy ->
        civil_pack y (div (add 2 < mul 5 doy) 153) doy
    end
end

let civil_pack
    : Int -> Int -> Int -> (Int * (Int * Int))
    = fn y, mp, doy ->
        civil_done y (cond (ls mp 10) (add mp 3) (sub mp 9)) (succ < sub doy < div (add 2 < mul 153 mp) 5)
    end
end

let civil_done
    : Int -> Int -> Int -> (Int * (Int * Int))
    = fn y, m, d -> (cond (lse m 2) (succ y) y * (m * d)) end
end

# Floors toward negative infinity (float_to_int truncates toward zero).
let floor_int
    : Float -> Int
    = fn x ->
        cond (ls x < int_to_float < float_to_int x)
            (pred < float_to_int x)
            (float_to_int x)
    end
end

# The UTC date and time of seconds since 1970 (fractions are dropped).
let from_unix
    : Float -> DateTime
    = fn t -> from_days_secs (floor_int < div t 86400.0) (sub_secs t < floor_int < div t 86400.0) end
end

let sub_secs
    : Float -> Int -> Int
    = fn t, days -> floor_int (sub t (mul (int_to_float days) 86400.0)) end
end

let from_days_secs
    : Int -> Int -> DateTime
    = fn days, secs ->
        build_date (civil_from_days days) (div secs 3600) (div (mod secs 3600) 60) (mod secs 60)
    end
end

let build_date
    : (Int * (Int * Int)) -> Int -> Int -> Int -> DateTime
    = match
        (y * (m * d)), h, mi, s -> make y m d h mi s end
    end
end

# Seconds since 1970 of a UTC date and time.
let to_unix
    : DateTime -> Float
    = fn dt ->
        add (mul (int_to_float (days_from_civil (year dt) (month dt) (day dt))) 86400.0)
            (int_to_float (add (add (mul (hour dt) 3600) (mul (minute dt) 60)) (second dt)))
    end
end

# 0 = Sunday ... 6 = Saturday
let weekday
    : DateTime -> Int
    = fn dt -> mod (add 4 < days_from_civil (year dt) (month dt) (day dt)) 7 end
end

# 1-366
let day_of_year
    : DateTime -> Int
    = fn dt -> succ < sub (days_from_civil (year dt) (month dt) (day dt)) (days_from_civil (year dt) 1 1) end
end

let add_seconds
    : Float -> DateTime -> DateTime
    = fork2 from_unix add to_unix
end

# The local time zone's offset from UTC, in seconds east, at a moment in time.
let local_offset
    : Float -> IO Int
    = prim_offset
end

# The current local date and time.
let now_local
    : IO DateTime
    = now > bind < fn t -> local_offset t >
        bind < comp return < comp from_unix < comp (add t) int_to_float
    end
end

# ---- formatting ----

let weekday_names
    : List String
    = ["Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"]
end

let month_names
    : List String
    = ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"]
end

# strftime-style: %Y year, %m month, %d day, %H hour (00-23), %M minute, %S second,
# %y two-digit year, %e day padded with a space, %j day of the year, %a/%A short/full weekday
# name, %b/%B short/full month name, %F is %Y-%m-%d, %T is %H:%M:%S, %% is a percent sign.
let format
    : String -> DateTime -> String
    = format_go
end

let format_go
    : String -> DateTime -> String
    = match
        [], _ -> [] end
        List:Cons ('%' * List:Cons (c * rest)), dt -> append (Time:field c dt) (format_go rest dt) end
        List:Cons (c * rest), dt -> List:Cons (c * format_go rest dt) end
    end
end

let pad2
    : Int -> String
    = comp (Str:pad_left 2 '0') show
end

let field
    : Char -> DateTime -> String
    = match
        'Y', dt -> show < year dt end
        'y', dt -> pad2 < mod (year dt) 100 end
        'm', dt -> pad2 < month dt end
        'd', dt -> pad2 < day dt end
        'e', dt -> Str:pad_left 2 ' ' < show < day dt end
        'H', dt -> pad2 < hour dt end
        'M', dt -> pad2 < minute dt end
        'S', dt -> pad2 < second dt end
        'j', dt -> Str:pad_left 3 '0' < show < day_of_year dt end
        'A', dt -> Time:name_at weekday_names < weekday dt end
        'a', dt -> take 3 < Time:name_at weekday_names < weekday dt end
        'B', dt -> Time:name_at month_names < pred month dt end
        'b', dt -> take 3 < Time:name_at month_names < pred < month dt end
        'F', dt -> Time:format "%Y-%m-%d" dt end
        'T', dt -> Time:format "%H:%M:%S" dt end
        '%', _  -> "%" end
        c, _    -> ['%', c] end
    end
end

let name_at
    : List String -> Int -> String
    = fn names, i -> cond (eq i 0) (nth_head names) (name_at (tail_or_nil names) (pred i)) end
end

let nth_head
    : List String -> String
    = match
        []                 -> [] end
        List:Cons (x * _)  -> x end
    end
end

let tail_or_nil
    : List String -> List String
    = match
        []                 -> [] end
        List:Cons (_ * xs) -> xs end
    end
end

# 2024-03-09T14:05:09Z
let iso8601
    : DateTime -> String
    = fn dt -> append (Time:format "%Y-%m-%dT%H:%M:%S" dt) "Z" end
end
